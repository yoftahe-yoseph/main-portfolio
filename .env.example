# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY / NEXT_PUBLIC_GOOGLE_MAPS_API_KEY / VITE_GOOGLE_MAPS_API_KEY:
# Required for Google Maps Platform (Maps JS API & Places API New).
# Automatically provisioned or configured via the AI Studio environment.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# CONTACT EMAIL DELIVERY (Server-side only — configure in Settings > Secrets)
# Recipient address receiving portfolio contact form messages:
CONTACT_TO_EMAIL="yoftaheyoseph5@gmail.com"
# Option 1 (Recommended for Gmail): 16-character Gmail App Password for yoftaheyoseph5@gmail.com
GMAIL_APP_PASSWORD=""
# Option 2 (Custom SMTP):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="yoftaheyoseph5@gmail.com"
SMTP_PASS=""
# Option 3 (Resend HTTPS Email API):
RESEND_API_KEY=""
CONTACT_FROM_EMAIL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
